generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Palette {
  id             String   @id @default(cuid())
  name           String
  industry       String?
  department     String?
  primaryColors  String[]
  secondaryColors String[]
  accentColors   String[]
  textColors     String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}